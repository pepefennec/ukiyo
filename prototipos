function renderItemCard(x){if(!x)return'';const type=prettyType(x.id);return `<article class="card item-card" tabindex="0" role="button" onclick="openItem('${esc(x.id)}')" onkeydown="if(event.key==='Enter')openItem('${esc(x.id)}')">${cover(x)}<div><div class="titleline"><strong>${esc(x.name)}</strong><span class="muted">↗</span></div><div class="meta">${esc(type)} · ${esc(x.duration||30)} min</div><div class="row wrap" style="gap:5px;margin-top:9px">${(x.cats||[]).slice(0,2).map(tag).join('')}</div></div></article>`}
function renderBiblioteca(){const filters=['Todo','Actividades','Experiencias','Proyectos','Rituales'];const sets=[...state.activities,...state.experiences,...state.projects,...state.rituals].filter(x=>(libFilter==='Todo'||({'Actividades':'a','Experiencias':'e','Proyectos':'p','Rituales':'r'}[libFilter]===x.id.charAt(0)))&&(!libSearch||`${x.name} ${x.description||''}`.toLowerCase().includes(libSearch.toLowerCase())));
return `<div class="row between wrap" style="margin-bottom:18px"><div><div class="eyebrow">Tu colección personal</div><h1>Biblioteca</h1><p class="lead">Actividades, historias, proyectos y rituales que quieres disfrutar.</p></div><button class="btn" onclick="newItemMenu()">＋ Añadir a biblioteca</button></div><div class="row between wrap" style="margin:20px 0 13px"><div class="filters">${filters.map(f=>`<button class="${f===libFilter?'active':''}" onclick="libFilter='${f}';render()">${f}</button>`).join('')}</div><div class="searchbar"><input aria-label="Buscar en la biblioteca" placeholder="⌕ Buscar..." value="${esc(libSearch)}" oninput="libSearch=this.value;render();let x=document.querySelector('.searchbar input');x.focus();x.setSelectionRange(x.value.length,x.value.length)"></div></div><p class="small muted" style="margin:0 0 15px">${sets.length} elementos · Todos son editables o eliminables</p>${sets.length?`<div class="grid-4">${sets.map(renderItemCard).join('')}</div>`:`<div class="empty"><span class="big">✦</span>No encontramos elementos. Puedes crear uno nuevo.</div>`}`}
function renderPlanes(){const filters=['Todos','Solo','Pareja','Amigos','Familia'];let arr=state.plans.filter(p=>planFilter==='Todos'||p.people===planFilter);return `<div class="row between wrap"><div><div class="eyebrow">Tiempo con intención, sin rigidez</div><h1>Planes</h1><p class="lead">Días libres, encuentros y vacaciones. Una idea puede convertirse en itinerario o en simple diario.</p></div><button class="btn" onclick="openPlanEditor()">＋ Nuevo plan</button></div><div class="section-head" style="margin-top:25px"><div><h2>Inspiración para tus días</h2><p>Cuatro plantillas listas para personalizar.</p></div></div><div class="filters">${filters.map(f=>`<button class="${f===planFilter?'active':''}" onclick="planFilter='${f}';render()">${f}</button>`).join('')}</div><div class="grid-2" style="margin-top:13px">${arr.map(p=>`<article class="card plan-card" tabindex="0" role="button" onclick="openPlan('${esc(p.id)}')" onkeydown="if(event.key==='Enter')openPlan('${esc(p.id)}')">${cover(p)}<div class="plan-content"><div class="row between wrap" style="margin-bottom:5px">${tag(p.people)}<span class="tag neutral">${p.template?'Plantilla':'Mi plan'}</span></div><h3>${esc(p.name)}</h3><p class="lead small">${esc(p.description||'')}</p><div class="plan-days">▤ ${p.days} ${p.days===1?'día':'días'} · Presupuesto ${esc(p.budget?.toLowerCase()||'flexible')}</div><div class="row between"><span class="small muted">${p.schedule.length} ${p.schedule.length===1?'jornada':'jornadas'}</span><span class="point small">Explorar →</span></div></div></article>`).join('')}</div>`}
function renderMemorias(){const mem=[...state.memories].sort((a,b)=>new Date(b.at)-new Date(a.at));const filters=['Todas','Descanso','Entretenimiento','Creación'];const found=mem.filter(m=>memoryFilter==='Todas'||m.cats?.includes(memoryFilter));const mins=mem.reduce((a,m)=>a+(m.seconds||0),0);return `<div class="eyebrow">Las huellas de lo que disfrutas</div><h1>Memorias</h1><p class="lead">Un pequeño archivo de momentos, sin rachas ni objetivos.</p><div class="grid-3" style="margin-top:24px"><div class="card stat"><span class="small muted">Sesiones</span><div class="num">${mem.length}</div></div><div class="card stat"><span class="small muted">Tiempo registrado</span><div class="num">${Math.floor(mins/3600)}h ${Math.floor((mins%3600)/60)}m</div></div><div class="card stat"><span class="small muted">Recuerdos favoritos</span><div class="num">${mem.filter(m=>m.favorite).length}</div></div></div><div class="section-head"><div><h2>Tu historia reciente</h2><p>Las sesiones terminadas se registran automáticamente.</p></div><button class="btn alt small" onclick="openManualMemory()">＋ Añadir recuerdo</button></div><div class="filters">${filters.map(f=>`<button class="${f===memoryFilter?'active':''}" onclick="memoryFilter='${f}';render()">${f}</button>`).join('')}</div><div class="stack" style="margin-top:12px">${found.length?found.map(m=>{const item=getItem(m.itemId);return `<div class="card memory"><div class="memory-ico">${esc(item?.icon||'✦')}</div><div style="flex:1;min-width:0"><div class="row between wrap"><strong>${esc(m.name)}</strong><span class="small muted">${dateLabel(m.at)}</span></div><p class="small muted" style="margin:6px 0">${m.seconds?Math.round(m.seconds/60)+' min · ':''}${esc((m.cats||[]).join(' · '))}</p>${m.note?`<p class="small" style="margin-bottom:9px">${esc(m.note)}</p>`:''}<div class="actions-inline"><button class="btn alt smaller" onclick="toggleFav('${esc(m.id)}')">${m.favorite?'♥ Destacado':'♡ Destacar'}</button><button class="btn ghost smaller" onclick="editMemory('${esc(m.id)}')">Editar nota</button><button class="btn ghost smaller" onclick="deleteMemory('${esc(m.id)}')">Eliminar</button></div></div></div>`}).join(''):`<div class="empty"><span class="big">✧</span><strong>Aquí aparecerán tus momentos.</strong><br><span class="small">Prueba iniciar una actividad con temporizador, o añade un recuerdo manualmente.</span></div>`}</div>`}
function renderAjustes(){return `<div class="eyebrow">A tu manera</div><h1>Ajustes</h1><p class="lead">Controla tus preferencias y los datos de este prototipo.</p><div class="stack" style="margin-top:24px"><section class="card"><h3>Tu experiencia</h3><div class="field"><label>Apariencia</label><select onchange="state.settings.theme=this.value;save();toast('Preferencia guardada (tema claro en este prototipo)')"><option ${state.settings.theme==='Claro'?'selected':''}>Claro</option><option ${state.settings.theme==='Sistema'?'selected':''}>Sistema</option><option ${state.settings.theme==='Oscuro'?'selected':''}>Oscuro</option></select><p class="microcopy">La interfaz final podrá respetar el tema del sistema; aquí se presenta la identidad visual clara.</p></div><div class="subtle-line"></div><div class="toggle"><input type="checkbox" disabled><label>Notificaciones nativas (disponibles tras integrar Android)</label></div></section><section class="card"><h3>Tus datos</h3><p class="lead small" style="margin-bottom:17px">Este prototipo funciona sin servidor y guarda su información en el almacenamiento del navegador donde lo abres. No constituye todavía la base de datos ni el almacenamiento de archivos de la futura APK.</p><div class="actions-inline"><button class="btn" onclick="exportData()">↓ Exportar respaldo JSON</button><label class="btn alt" style="cursor:pointer">↑ Importar respaldo<input type="file" accept="application/json,.json" style="display:none" onchange="importData(this.files[0])"></label><button class="btn alt" onclick="resetData()">Restablecer ejemplos</button></div></section><section class="card"><h3>Sobre Ukiyo V2</h3><p class="lead small">Descanso · Entretenimiento · Creación · Planes · Memorias. Una herramienta para el tiempo libre, no para la productividad.</p><div class="paper-note margintop">Versión de demostración HTML. No incluye lector EPUB, sincronización, alarmas nativas ni una APK empaquetada. Las portadas son ilustraciones tipográficas integradas y puedes reemplazarlas por imágenes propias.</div></section></div>`}
function openModal(title,html){currentModal={title};document.getElementById('modalMount').innerHTML=`<div class="modal-overlay" onclick="if(event.target===this)closeModal()"><section class="modal" role="dialog" aria-modal="true" aria-label="${esc(title)}"><div class="modal-head"><h2>${esc(title)}</h2><button class="close" aria-label="Cerrar" onclick="closeModal()">✕</button></div><div class="modal-body">${html}</div></section></div>`;document.body.style.overflow='hidden'}
function closeModal(){currentModal=null;document.getElementById('modalMount').innerHTML='';document.body.style.overflow=''}
function openCheckin(){const c=state.checkin||{mood:'En calma',moodEmoji:'😌',energy:'Media',time:60,intent:'Un poco de todo',note:''};openModal('Mi ritual de entrada',`<p class="lead" style="margin-bottom:20px">No necesitas sentirte de ninguna manera especial. Solo elige cómo estás ahora.</p><form onsubmit="saveCheckin(event)"><div class="field"><label>¿Cómo te sientes?</label><div class="mood">${[['Cansado','😴'],['Tranquilo','😌'],['Neutral','🙂'],['Animado','😊'],['Emocionado','✨']].map(([m,e])=>`<label class="choice ${c.mood===m?'selected':''}"><input type="radio" name="mood" value="${m}" ${c.mood===m?'checked':''} hidden onchange="document.querySelectorAll('.mood .choice').forEach(x=>x.classList.remove('selected'));this.parentElement.classList.add('selected')"><span class="emoji">${e}</span><span>${m}</span></label>`).join('')}</div></div><div class="form-grid margintop"><div class="field"><label>Tu energía</label><select name="energy"><option ${c.energy==='Baja'?'selected':''}>Baja</option><option ${c.energy==='Media'?'selected':''}>Media</option><option ${c.energy==='Alta'?'selected':''}>Alta</option></select></div><div class="field"><label>Tiempo disponible (min)</label><input type="number" name="time" min="10" max="1440" value="${Number(c.time)||60}" required></div></div><div class="field margintop"><label>¿Qué te apetece?</label><select name="intent">${['Descanso','Entretenimiento','Creación','Un poco de todo'].map(x=>`<option ${x===c.intent?'selected':''}>${x}</option>`).join('')}</select></div><div class="field margintop"><label>Una nota para ti (opcional)</label><textarea name="note" placeholder="Hoy me gustaría...">${esc(c.note)}</textarea></div><div class="form-actions"><button type="button" class="btn alt" onclick="closeModal()">Ahora no</button><button class="btn" type="submit">✦ Ver sugerencias</button></div></form>`)}
function saveCheckin(e){e.preventDefault();const f=e.target,mood=f.mood.value||'Tranquilo';let emojis={Cansado:'😴',Tranquilo:'😌',Neutral:'🙂',Animado:'😊',Emocionado:'✨'};state.checkin={mood,moodEmoji:emojis[mood],energy:f.energy.value,time:Math.max(10,Math.min(1440,Number(f.time.value)||60)),intent:f.intent.value,note:f.note.value,at:new Date().toISOString()};save();closeModal();buildProposal()}
function buildProposal(){if(!state.checkin)return openCheckin();const c=state.checkin,cap=c.time;let items=allItems().filter(x=>{if(c.intent!=='Un poco de todo'&&!(x.cats||[]).includes(c.intent))return false;if(c.energy==='Baja'&&x.energy==='Alta')return false;return true});const catOrder=c.intent==='Un poco de todo'?['Descanso','Entretenimiento','Creación']: [c.intent];let selected=[],used=0;for(const cat of catOrder){const group=items.filter(x=>x.cats?.includes(cat)&&!selected.some(s=>s.itemId===x.id));group.sort((a,b)=>{let score=x=>x.energy==='Alta'&&c.energy==='Alta'?-2:0;return Math.abs((a.duration||30)-Math.min(cap/2,60))+score(a)-Math.abs((b.duration||30)-Math.min(cap/2,60))-score(b)});const candidate=group.find(x=>x.duration<=cap-used)||group[0];if(candidate){let time=Math.min(candidate.duration,cap-used);if(time>=10){selected.push({id:uid('q'),itemId:candidate.id,minutes:time});used+=time}}}if(!selected.length){const candidate=items.find(x=>x.duration<=cap)||items[0];if(candidate)selected=[{id:uid('q'),itemId:candidate.id,minutes:Math.min(candidate.duration,cap)}]};state.proposal=selected;save();render();document.getElementById('proposalBox')?.scrollIntoView({behavior:'smooth',block:'center'});toast('Estas son solo ideas. Puedes cambiarlas a tu gusto.')}
function renderProposal(){const q=state.proposal,sum=q.reduce((s,x)=>s+(Number(x.minutes)||0),0);return `<section class="card" id="proposalBox" style="margin-top:20px"><div class="row between wrap"><div><div class="eyebrow">Una posibilidad para tu momento</div><h3>Tu propuesta, a tu manera</h3><p class="small muted">Reordena, cambia duraciones o quita lo que no te apetezca.</p></div><button class="btn alt small" onclick="buildProposal()">↻ Otra sugerencia</button></div><div class="stack" style="margin-top:19px">${q.map((r,i)=>{const item=getItem(r.itemId);if(!item)return'';return `<div class="routine-row"><div class="mini-icon">${esc(item.icon)}</div><div style="flex:1;min-width:120px"><strong>${esc(item.name)}</strong><div class="tiny muted">${esc(prettyType(item.id))}</div></div><div class="right"><input type="number" title="Duración en minutos" min="1" max="1440" value="${r.minutes}" onchange="changeProposalTime('${r.id}',this.value)"><button class="iconbtn" ${i===0?'disabled':''} onclick="moveProposal(${i},-1)" title="Subir">↑</button><button class="iconbtn" ${i===q.length-1?'disabled':''} onclick="moveProposal(${i},1)" title="Bajar">↓</button><button class="iconbtn" onclick="removeProposal('${r.id}')" title="Quitar">✕</button></div></div>`}).join('')}</div><div class="row between wrap" style="margin-top:17px"><span class="small muted">${sum} de ${state.checkin?.time||0} min propuestos ${sum<(state.checkin?.time||0)?'· Tiempo libre: '+((state.checkin?.time||0)-sum)+' min':''}</span><button class="btn alt small" onclick="openProposalAdd()">＋ Añadir otra actividad</button></div><div class="actions-inline margintop"><button class="btn" ${q.length?'':'disabled'} onclick="startProposalItem(0)">▶ Empezar la primera actividad</button><button class="btn ghost" onclick="state.proposal=[];save();render()">Descartar propuesta</button></div></section>`}
function changeProposalTime(id,v){const q=state.proposal.find(x=>x.id===id);if(q){q.minutes=Math.max(1,Math.min(1440,Number(v)||1));save();render()}}
function moveProposal(i,dir){const j=i+dir;if(j<0||j>=state.proposal.length)return;[state.proposal[i],state.proposal[j]]=[state.proposal[j],state.proposal[i]];save();render()}
function removeProposal(id){state.proposal=state.proposal.filter(x=>x.id!==id);save();render()}
function openProposalAdd(){openModal('Añadir a mi momento',`<p class="lead">Elige cualquier elemento de tu biblioteca.</p><div class="stack margintop">${allItems().map(x=>`<button class="btn alt full" style="justify-content:space-between;text-align:left" onclick="addProposal('${esc(x.id)}')"><span>${esc(x.icon)} ${esc(x.name)}</span><span class="small muted">${x.duration||30} min ＋</span></button>`).join('')}</div>`)}
function addProposal(id){const x=getItem(id);if(!x)return;state.proposal.push({id:uid('q'),itemId:id,minutes:x.duration||30});save();closeModal();render()}
