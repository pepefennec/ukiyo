const mem=state.memories.filter(m=>m.itemId===id);openModal(x.name,`${cover(x,'details-cover')}<div class="row wrap" style="margin-bottom:14px">${(x.cats||[]).map(tag).join('')}<span class="tag neutral">${esc(x.energy||'Variable')} · ${x.duration||30} min sugeridos</span></div><p class="lead">${esc(x.description||'Un momento para disfrutar a tu manera.')}</p>${x.link?`<p class="small margintop"><a href="${esc(safeUrl(x.link))}" target="_blank" rel="noopener noreferrer">Abrir enlace relacionado ↗</a></p>`:''}<div class="subtle-line"></div>${extra}<div class="paper-note margintop">${mem.length} ${mem.length===1?'sesión registrada':'sesiones registradas'}${mem.length?` · ${Math.round(mem.reduce((s,m)=>s+(m.seconds||0),0)/60)} min disfrutados`:''}</div><div class="form-actions"><button class="btn alt" onclick="editItem('${esc(id)}')">✎ Editar</button><button class="btn" onclick="startTimer('${esc(id)}',${Number(x.duration)||30})">▶ Iniciar sesión</button></div>`)}
function toggleStep(id,i,v){const x=getItem(id);if(x?.steps?.[i]){x.steps[i].done=v;save();toast('Etapa actualizada')}}
function newItemMenu(){openModal('¿Qué quieres añadir?',`<p class="lead">Elige qué tipo de experiencia quieres guardar.</p><div class="grid-2 margintop">${[['activities','✎','Actividad recurrente'],['experiences','✦','Experiencia específica'],['projects','⌘','Proyecto personal'],['rituals','🌿','Ritual de autocuidado']].map(([t,icon,n])=>`<button class="btn alt" style="min-height:85px;flex-direction:column" onclick="editItem(null,'${t}')"><span style="font-size:25px">${icon}</span>${n}</button>`).join('')}</div>`)}
function editItem(id=null,forcedType=null){const x=id?getItem(id):null,tp=forcedType||typeOf(id||'a'),label={activities:'actividad',experiences:'experiencia',projects:'proyecto',rituals:'ritual'}[tp];const v=x||{};openModal((x?'Editar ':'Nueva ')+label,`<form id="itemForm" onsubmit="saveItem(event,'${esc(tp)}','${esc(id||'')}')"><div class="form-grid"><div class="field"><label>Nombre</label><input name="name" required maxlength="110" value="${esc(v.name||'')}" placeholder="Ej. Dibujar mi personaje"></div><div class="field"><label>Duración sugerida (min)</label><input name="duration" type="number" min="1" max="1440" value="${v.duration||30}" required></div><div class="field"><label>Energía sugerida</label><select name="energy">${['Muy baja','Baja','Media','Alta','Variable'].map(z=>`<option ${v.energy===z?'selected':''}>${z}</option>`).join('')}</select></div><div class="field"><label>Icono (emoji o símbolo)</label><input name="icon" maxlength="8" value="${esc(v.icon||'✦')}"></div></div><div class="field margintop"><label>Categorías (puedes elegir varias)</label><div class="seg">${['Descanso','Entretenimiento','Creación'].map(c=>`<label class="toggle" style="padding:7px 8px"><input type="checkbox" name="cat" value="${c}" ${(v.cats||['Entretenimiento']).includes(c)?'checked':''}>${c}</label>`).join('')}</div></div><div class="field margintop"><label>Descripción</label><textarea name="description" placeholder="¿Qué te gusta de esta actividad?">${esc(v.description||'')}</textarea></div><div class="form-grid margintop"><div class="field"><label>Portada desde tu dispositivo</label><input name="coverFile" type="file" accept="image/png,image/jpeg,image/webp" style="padding:9px"><span class="microcopy">Se redimensiona para guardar una miniatura local; no se sube a ningún servidor.</span></div><div class="field"><label>Color de la portada alternativa</label><select name="tone">${['terracotta','sage','gold','blue','plum','cream'].map(t=>`<option ${v.tone===t?'selected':''} value="${t}">${({terracotta:'Terracota',sage:'Verde salvia',gold:'Dorado',blue:'Azul',plum:'Malva',cream:'Crema'})[t]}</option>`).join('')}</select></div></div>${tp==='experiences'?`<div class="form-grid margintop"><div class="field"><label>Tipo</label><select name="kind">${['Libro','Película','Serie','Videojuego','Álbum','Pasatiempo','Otro'].map(z=>`<option ${v.kind===z?'selected':''}>${z}</option>`).join('')}</select></div><div class="field"><label>Estado</label><select name="status">${['Pendiente','En progreso','Terminado','En pausa'].map(z=>`<option ${v.status===z?'selected':''}>${z}</option>`).join('')}</select></div></div><div class="field margintop"><label>Progreso libre (opcional)</label><input name="progress" value="${esc(v.progress||'')}" placeholder="Ej. Temporada 2, episodio 3"></div><div class="field margintop"><label>Enlace relacionado (opcional)</label><input name="link" type="url" value="${esc(v.link||'')}" placeholder="https://..."></div>`:''}${tp==='projects'?`<div class="field margintop"><label>Próximo paso (opcional)</label><input name="next" value="${esc(v.next||'')}" placeholder="Ej. Dibujar el primer boceto"></div><div class="field margintop"><label>Etapas, una por línea</label><textarea name="steps">${esc((v.steps||[]).map(s=>s.name).join('\n'))}</textarea></div><div class="field margintop"><label>Recursos o notas</label><textarea name="resources">${esc(v.resources||'')}</textarea></div>`:''}${tp==='rituals'?`<div class="field margintop"><label>Pasos, uno por línea (nombre | minutos)</label><textarea name="steps" placeholder="Ducha tibia | 20&#10;Leer | 15">${esc((v.steps||[]).map(s=>s.join(' | ')).join('\n'))}</textarea></div><div class="field margintop"><label>Instrucciones mínimas (desplegables)</label><textarea name="guide">${esc(v.guide||'')}</textarea></div><div class="field margintop"><label>Precauciones</label><textarea name="warning">${esc(v.warning||'')}</textarea></div>`:''}<div class="form-actions">${id?`<button type="button" class="btn ghost" onclick="deleteItem('${esc(id)}')">Eliminar</button>`:''}<button type="button" class="btn alt" onclick="closeModal()">Cancelar</button><button class="btn" type="submit">Guardar ${label}</button></div></form>`)}
function safeUrl(s){try{const u=new URL(s);return ['https:','http:'].includes(u.protocol)?u.href:'#'}catch(e){return '#'}}
function compressFile(file){return new Promise((resolve,reject)=>{if(!file)return resolve(null);if(file.size>12*1024*1024)return reject(Error('Usa una imagen menor a 12 MB'));const reader=new FileReader();reader.onload=()=>{const im=new Image();im.onload=()=>{const max=680;const ratio=Math.min(1,max/Math.max(im.width,im.height));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(im.width*ratio));c.height=Math.max(1,Math.round(im.height*ratio));c.getContext('2d').drawImage(im,0,0,c.width,c.height);resolve(c.toDataURL('image/jpeg',.72))};im.onerror=()=>reject(Error('No se pudo abrir la imagen'));im.src=reader.result};reader.onerror=()=>reject(Error('No se pudo leer el archivo'));reader.readAsDataURL(file)})}
async function saveItem(e,tp,id){e.preventDefault();const f=e.target,old=id?getItem(id):null,arr=state[tp],x=old||{id:uid(({activities:'a',experiences:'e',rituals:'r',projects:'p'})[tp])};const cats=[...f.querySelectorAll('[name=cat]:checked')].map(y=>y.value);if(!cats.length){toast('Selecciona al menos una categoría');return}Object.assign(x,{name:f.elements.namedItem("name").value.trim(),duration:Number(f.duration.value),energy:f.energy.value,icon:f.icon.value||'✦',cats,description:f.description.value,tone:f.tone.value});if(tp==='experiences')Object.assign(x,{kind:f.kind.value,status:f.status.value,progress:f.progress.value,link:safeUrl(f.link.value)==='#'?'':safeUrl(f.link.value)});if(tp==='projects'){x.next=f.next.value;x.resources=f.resources.value;const oldSteps=x.steps||[];x.steps=f.steps.value.split('\n').map(s=>s.trim()).filter(Boolean).map(name=>({name,done:oldSteps.find(v=>v.name===name)?.done||false}))}if(tp==='rituals'){x.steps=f.steps.value.split('\n').map(z=>z.trim()).filter(Boolean).map(z=>{const [n,m]=z.split('|');return[n.trim(),Math.max(1,Number(m)||10)]});x.guide=f.guide.value;x.warning=f.warning.value}try{const cover=await compressFile(f.coverFile.files[0]);if(cover)x.cover=cover}catch(err){toast(err.message);return}if(!old)arr.push(x);save();closeModal();render();toast('Guardado en tu biblioteca')}
function deleteItem(id){const x=getItem(id);if(!x||!confirm(`¿Eliminar «${x.name}» de la biblioteca? Los recuerdos registrados no se eliminarán.`))return;state[typeOf(id)]=state[typeOf(id)].filter(a=>a.id!==id);state.proposal=state.proposal.filter(a=>a.itemId!==id);save();closeModal();render();toast('Elemento eliminado')}
function openPlan(id){const p=state.plans.find(x=>x.id===id);if(!p)return;openModal(p.name,`${cover(p,'details-cover')}<div class="row wrap">${tag(p.people)}<span class="tag neutral">${p.days} ${p.days===1?'día':'días'}</span><span class="tag neutral">Presupuesto ${esc(p.budget||'Flexible')}</span><span class="tag ${p.template?'gold':'green'}">${p.template?'Plantilla':'Plan personal'}</span></div><p class="lead margintop">${esc(p.description||'')}</p>${p.date?`<p class="small muted">Inicio previsto: ${esc(p.date)}</p>`:''}<div class="section-head"><div><h3>Itinerario flexible</h3><p>Estos bloques se pueden cambiar o eliminar.</p></div></div><div class="stack">${p.schedule.map((d,i)=>`<div class="day-block"><h4>${esc(d.title||'Día '+(i+1))}</h4>${d.blocks.map(b=>`<div class="day-activity"><span class="dot"></span><div><strong class="small">${esc(b.when)}</strong><div class="small muted">${esc(b.what)}${b.ref&&getItem(b.ref)?` · <span class="point">Biblioteca</span>`:''}</div></div></div>`).join('')||'<span class="small muted">Día libre, sin actividades programadas.</span>'}</div>`).join('')}</div>${p.notes?`<div class="paper-note margintop">${strip(p.notes)}</div>`:''}<div class="form-actions"><button class="btn alt" onclick="editPlan('${esc(id)}')">✎ Editar</button><button class="btn" onclick="duplicatePlan('${esc(id)}')">${p.template?'Usar este plan':'Duplicar plan'} →</button></div>`)}
function duplicatePlan(id){const p=state.plans.find(a=>a.id===id);if(!p)return;const copy=structuredClone(p);copy.id=uid('pl');copy.template=false;copy.name=p.template?p.name:p.name+' (copia)';copy.date='';state.plans.push(copy);save();closeModal();toast('Copia personal creada: ahora puedes editarla');editPlan(copy.id)}
function openPlanEditor(){editPlan(null)}
function editPlan(id){const p=id?state.plans.find(x=>x.id===id):null;const v=p||{name:'',people:'Solo',days:1,budget:'Bajo',description:'',notes:'',date:'',icon:'☀',tone:'terracotta',schedule:[{title:'Día 1',blocks:[]}]};openModal(p?'Editar plan':'Nuevo plan',`<form id="planForm" onsubmit="savePlan(event,'${esc(id||'')}')"><div class="form-grid"><div class="field"><label>Nombre</label><input name="name" required value="${esc(v.name)}" placeholder="Ej. Domingo tranquilo"></div><div class="field"><label>Modalidad</label><select name="people">${['Solo','Pareja','Amigos','Familia'].map(x=>`<option ${v.people===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Número de días</label><input type="number" name="days" min="1" max="30" required value="${v.days}"></div><div class="field"><label>Fecha de inicio (opcional)</label><input type="date" name="date" value="${esc(v.date)}"></div><div class="field"><label>Presupuesto orientativo</label><select name="budget">${['Bajo','Bajo–medio','Medio','Flexible'].map(x=>`<option ${v.budget===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Icono</label><input name="icon" value="${esc(v.icon)}" maxlength="8"></div></div><div class="field margintop"><label>Descripción</label><textarea name="description">${esc(v.description)}</textarea></div><div class="field margintop"><label>Diario / ideas libres</label><textarea name="notes" placeholder="Ideas, lugares, enlaces o lo que quieras recordar">${esc(v.notes)}</textarea></div><div class="field margintop"><label>Itinerario (un bloque por línea). Formato: Día 1 | Mañana | Actividad</label><textarea name="schedule" style="min-height:190px" placeholder="Día 1 | Mañana | Desayunar tranquilo&#10;Día 1 | Tarde | Leer">${esc(v.schedule.map((d,i)=>d.blocks.map(b=>`Día ${i+1} | ${b.when} | ${b.what}`).join('\n')).filter(Boolean).join('\n'))}</textarea><p class="microcopy">Puedes dejarlo vacío. Para una plantilla existente, conserva los textos que quieras y cambia el resto. La versión definitiva permitirá editar cada bloque visualmente y vincular elementos de Biblioteca.</p></div><div class="form-actions">${p&&!p.template?`<button type="button" class="btn ghost" onclick="deletePlan('${esc(id)}')">Eliminar</button>`:''}<button type="button" class="btn alt" onclick="closeModal()">Cancelar</button><button class="btn" type="submit">Guardar plan</button></div></form>`)}
function savePlan(e,id){e.preventDefault();const f=e.target,old=state.plans.find(x=>x.id===id);const lines=f.schedule.value.split('\n').map(x=>x.trim()).filter(Boolean),days=Math.max(1,Math.min(30,Number(f.days.value)||1));let schedule=Array.from({length:days},(_,i)=>({title:'Día '+(i+1),blocks:[]}));lines.forEach(line=>{let bits=line.split('|').map(s=>s.trim());let d=Number((bits[0]||'').match(/\d+/)?.[0]||1)-1;d=Math.max(0,Math.min(days-1,d));if(bits.length>2)schedule[d].blocks.push({when:bits[1]||'Libre',what:bits.slice(2).join(' | ')});else schedule[d].blocks.push({when:'Libre',what:line})});let x=old||{id:uid('pl'),tone:'sage',template:false};Object.assign(x,{name:f.elements.namedItem("name").value.trim(),people:f.people.value,days,budget:f.budget.value,description:f.description.value,notes:f.notes.value,date:f.date.value,icon:f.icon.value||'✦',schedule});if(!old)state.plans.push(x);save();closeModal();render();toast('Plan guardado')}
function deletePlan(id){if(!confirm('¿Eliminar este plan?'))return;state.plans=state.plans.filter(x=>x.id!==id);save();closeModal();render()}
function getTiming(s){let elapsed=s.elapsed||0;if(s.running&&s.startedAt)elapsed+=Math.max(0,Math.floor((Date.now()-s.startedAt)/1000));return elapsed}
function startTimer(id,minutes=null,proposalId=null){const item=getItem(id);if(!item)return;if(state.session){if(!confirm('Hay una sesión en curso. ¿Quieres terminarla sin guardar e iniciar otra?'))return}state.session={id:uid('session'),itemId:id,name:item.name,cats:item.cats||[],duration:Math.max(1,Number(minutes)||Number(item.duration)||30)*60,elapsed:0,startedAt:Date.now(),running:true,proposalId:proposalId||null,createdAt:new Date().toISOString()};save();closeModal();renderSessionBar();toast('Sesión iniciada · puedes pausarla o terminar cuando quieras')}
function renderSessionBar(){const mount=document.getElementById('sessionMount');const s=state.session;if(!s){mount.innerHTML='';return}const elapsed=getTiming(s),remaining=Math.max(0,s.duration-elapsed);mount.innerHTML=`<div class="session-bar"><div class="mini-icon" style="background:#ffffff24;color:white">${esc(getItem(s.itemId)?.icon||'◌')}</div><div style="flex:1;min-width:0"><div class="small" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(s.name)}</div><div class="time" id="timerTime">${fmt(remaining)}</div></div><button onclick="toggleTimer()" title="${s.running?'Pausar':'Reanudar'}">${s.running?'Ⅱ':'▶'}</button><button onclick="finishTimer()">Terminar</button></div>`;if(!tick)tick=setInterval(updateClock,1000);if(remaining===0&&s.running&&!s.warned){s.elapsed=getTiming(s);s.warned=true;s.running=false;s.startedAt=null;save();toast('Terminó el tiempo sugerido. Puedes finalizar o continuar tu momento.') }}
function updateClock(){const s=state.session;if(!s){clearInterval(tick);tick=null;return}const el=document.getElementById('timerTime');if(el)el.textContent=fmt(Math.max(0,s.duration-getTiming(s)));if(s.running&&getTiming(s)>=s.duration&&!s.warned){s.elapsed=getTiming(s);s.running=false;s.startedAt=null;s.warned=true;save();renderSessionBar();toast('Se alcanzó el tiempo sugerido. Puedes terminar o reanudar.')}}
function toggleTimer(){const s=state.session;if(!s)return;if(s.running){s.elapsed=getTiming(s);s.running=false;s.startedAt=null}else{s.running=true;s.startedAt=Date.now();s.warned=false}save();renderSessionBar()}
function finishTimer(){const s=state.session;if(!s)return;const secs=getTiming(s);s.elapsed=secs;s.running=false;save();openModal('¿Cómo estuvo tu momento?',`<p class="lead">${esc(s.name)} · ${Math.max(1,Math.round(secs/60))} minutos aproximadamente</p><p class="microcopy margintop">La duración real se registra. Puedes guardar una nota o simplemente terminar.</p><form onsubmit="saveSessionMemory(event)"><div class="field margintop"><label>¿Algo que quieras recordar? (opcional)</label><textarea name="note" placeholder="Una frase, un pensamiento, lo que disfrutaste..."></textarea></div><div class="toggle margintop"><input name="favorite" type="checkbox"><label>Marcar como recuerdo destacado</label></div><div class="form-actions"><button type="button" class="btn alt" onclick="discardSession()">Descartar sesión</button><button class="btn" type="submit">Guardar en Memorias</button></div></form>`)}
function saveSessionMemory(e){e.preventDefault();const s=state.session;if(!s)return;const f=e.target;state.memories.unshift({id:uid('m'),itemId:s.itemId,name:s.name,cats:s.cats,seconds:s.elapsed||getTiming(s),at:new Date().toISOString(),note:f.note.value,favorite:f.favorite.checked});if(s.proposalId)state.proposal=state.proposal.filter(x=>x.id!==s.proposalId);state.session=null;save();closeModal();render();toast('Tu momento quedó guardado en Memorias')}
function discardSession(){if(!confirm('¿Descartar esta sesión sin registrarla?'))return;state.session=null;save();closeModal();render()}
function toggleFav(id){let m=state.memories.find(x=>x.id===id);if(m)m.favorite=!m.favorite;save();render()}
function deleteMemory(id){if(!confirm('¿Eliminar este recuerdo?'))return;state.memories=state.memories.filter(x=>x.id!==id);save();render()}
function editMemory(id){const m=state.memories.find(x=>x.id===id);if(!m)return;openModal('Editar recuerdo',`<form onsubmit="saveMemoryEdit(event,'${esc(id)}')"><div class="field"><label>Nombre</label><input name="name" required value="${esc(m.name)}"></div><div class="field margintop"><label>Nota personal</label><textarea name="note">${esc(m.note||'')}</textarea></div><div class="toggle margintop"><input type="checkbox" name="favorite" ${m.favorite?'checked':''}><label>Destacar</label></div><div class="form-actions"><button type="button" class="btn alt" onclick="closeModal()">Cancelar</button><button class="btn" type="submit">Guardar</button></div></form>`)}
function saveMemoryEdit(e,id){e.preventDefault();const f=e.target,m=state.memories.find(x=>x.id===id);if(!m)return;m.name=f.elements.namedItem("name").value;m.note=f.note.value;m.favorite=f.favorite.checked;save();closeModal();render()}
function openManualMemory(){openModal('Añadir recuerdo',`<form onsubmit="saveManualMemory(event)"><div class="field"><label>¿Qué disfrutaste?</label><input name="name" required placeholder="Ej. Un paseo al atardecer"></div><div class="form-grid margintop"><div class="field"><label>Categoría</label><select name="cat"><option>Descanso</option><option>Entretenimiento</option><option>Creación</option></select></div><div class="field"><label>Duración (minutos, opcional)</label><input name="duration" type="number" min="0" value="30"></div></div><div class="field margintop"><label>Nota (opcional)</label><textarea name="note"></textarea></div><div class="form-actions"><button class="btn alt" type="button" onclick="closeModal()">Cancelar</button><button class="btn" type="submit">Guardar recuerdo</button></div></form>`)}
function saveManualMemory(e){e.preventDefault();const f=e.target;state.memories.unshift({id:uid('m'),itemId:null,name:f.elements.namedItem("name").value,cats:[f.cat.value],seconds:Math.max(0,Number(f.duration.value)||0)*60,at:new Date().toISOString(),note:f.note.value,favorite:false});save();closeModal();render();toast('Recuerdo añadido')}
function exportData(){const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='ukiyo-v2-respaldo-'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);toast('Respaldo exportado')}
async function importData(file){if(!file)return;try{if(file.size>15*1024*1024)throw Error('El respaldo supera el límite de 15 MB');let data=JSON.parse(await file.text());if(!data||!Array.isArray(data.activities)||!Array.isArray(data.plans)||!Array.isArray(data.memories)||!Array.isArray(data.rituals)||!Array.isArray(data.experiences)||!Array.isArray(data.projects))throw Error('El archivo no tiene el formato de Ukiyo V2');if(!confirm('¿Reemplazar todos los datos actuales por este respaldo?'))return;state=data;state.settings=state.settings||{theme:'Claro'};state.proposal=state.proposal||[];save();render();toast('Respaldo importado correctamente')}catch(err){toast('No se pudo importar: '+err.message)}}
function resetData(){if(!confirm('¿Restablecer el prototipo? Se eliminarán tus sesiones, cambios y planes personales. Exporta un respaldo antes si quieres conservarlos.'))return;state=initialState();save();libFilter='Todo';libSearch='';planFilter='Todos';memoryFilter='Todas';render();toast('Ejemplos restaurados')}
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&currentModal)closeModal()});window.addEventListener('visibilitychange',()=>{if(!document.hidden)renderSessionBar()});save();render();
</script></body></html>
