function openItem(id){const x=getItem(id);if(!x)return;const tp=typeOf(id);let extra='';if(tp==='rituals'){extra=`<h4>Pasos sugeridos</h4><div class="stack">${(x.steps||[]).map(([n,m])=>`<div class="row between"><span>${esc(n)}</span><span class="muted small">${esc(m)} min</span></div>`).join('')}</div><details class="accordion"><summary>Instrucciones y precauciones ▾</summary><div class="inside">${strip(x.guide||'Disfrútalo a tu ritmo.')}<br><br><strong>Precaución:</strong> ${strip(x.warning||'Elige un entorno cómodo y seguro.')}</div></details>`}
if(tp==='projects'){extra=`<h4>Etapas opcionales</h4><div class="stack">${(x.steps||[]).map((s,i)=>`<label class="toggle"><input type="checkbox" ${s.done?'checked':''} onchange="toggleStep('${esc(id)}',${i},this.checked)"><span>${esc(s.name)}</span></label>`).join('')}</div><div class="paper-note margintop"><strong>Próximo paso:</strong> ${esc(x.next||'Sin definir')}</div>${x.resources?`<p class="small">Recursos: ${esc(x.resources)}</p>`:''}`}
