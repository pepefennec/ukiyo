let state;try{state=JSON.parse(localStorage.getItem(STORE));if(!state||!state.plans||!state.activities)throw Error('incompatible');}catch(e){state=initialState()}
let currentTab='inicio',libFilter='Todo',libSearch='',planFilter='Todos',memoryFilter='Todas',currentModal=null,proposalMode=false,showCheckin=true,tick=null;
function save(){try{localStorage.setItem(STORE,JSON.stringify(state))}catch(e){toast('No hay espacio suficiente para guardar. Prueba con una imagen más pequeña.')}}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function strip(v){return esc(v).replace(/\n/g,'<br>')}
function uid(pre){return pre+'_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7)}
function allItems(){return [...state.activities,...state.experiences,...state.rituals,...state.projects]}
function getItem(id){return allItems().find(x=>x.id===id)}
function typeOf(id){return id.startsWith('a')?'activities':id.startsWith('e')?'experiences':id.startsWith('r')?'rituals':'projects'}
function prettyType(id){return {activities:'Actividad',experiences:'Experiencia',rituals:'Ritual',projects:'Proyecto'}[typeOf(id)]}
function cover(item,cl=''){const tone=item.tone||'cream';const icon=esc(item.icon||'✦');const img=item.cover?'<img src="'+esc(item.cover)+'" alt="Portada de '+esc(item.name)+'">':'';return `<div class="cover ${esc(tone)} ${cl}"><span>${icon}</span>${img}</div>`}
function tag(t){return `<span class="tag ${t==='Descanso'?'green':t==='Creación'?'gold':'neutral'}">${esc(t)}</span>`}
function fmt(n){n=Math.max(0,Math.floor(Number(n)||0));return `${String(Math.floor(n/3600)).padStart(2,'0')}:${String(Math.floor(n%3600/60)).padStart(2,'0')}:${String(n%60).padStart(2,'0')}`}
function durationSec(item){return Math.max(60,(Number(item.duration)||30)*60)}
function dateLabel(d){return new Date(d).toLocaleDateString('es-MX',{day:'numeric',month:'short',year:'numeric'})}
function toast(msg){const mount=document.getElementById('toastMount');mount.innerHTML=`<div class="toast">${esc(msg)}</div>`;clearTimeout(window._toastTimer);window._toastTimer=setTimeout(()=>mount.innerHTML='',3300)}
